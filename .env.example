# ---------- Supabase (optional — without these the app runs in demo mode) ----------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---------- Site URL ----------
NEXT_PUBLIC_SITE_URL=https://akradhii.vercel.app

# ---------- Transactional email (optional) ----------
RESEND_API_KEY=

# ---------- WhatsApp Cloud API (Meta) — server only ----------
# Lead inbox number is fixed in code as +91 98485 79053 (919848579053).
# Override recipient with WHATSAPP_LEAD_TO if needed (digits only).
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_API_VERSION=v21.0
WHATSAPP_LEAD_TO=919848579053

# Optional: use an approved template instead of free-form text
# (required for business-initiated messages outside the 24h window)
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=en

# Optional secret for GET /api/leads when not using demo admin cookie
ADMIN_LEADS_SECRET=

# ---------- MongoDB (for persistent data storage) ----------
MONGODB_URI=mongodb://localhost:27017/akradhii

# ---------- Authentication ----------
AUTH_SECRET=your-secret-key-here

# ---------- Cloudinary (for file uploads) ----------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---------- Razorpay (for payments) ----------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
